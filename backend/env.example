# ---- Auth ----
# Used to sign JWT access/refresh tokens. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32

# ---- Database ----
# Leave DB_HOST unset to use the local MAMP socket fallback (db.js).
# Set all of the below when pointing at RDS / production.
# DB_HOST=your-rds.cluster-xxxxx.region.rds.amazonaws.com
# DB_PORT=3306
# DB_USER=app_user
# DB_PASSWORD=replace_with_strong_password
# DB_NAME=mhearts
# DB_SSL=true              # set to false to disable TLS
# DB_SSL_CA=/app/certs/global-bundle.pem   # RDS CA bundle (shipped in the Docker image)

# ---- App / runtime ----
NODE_ENV=production        # production enables secure cookies
PORT=3000
# FRONTEND_URL=https://your-domain.cloudfront.net   # CORS origin

# ---- OAuth: Fitbit ----
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=

# ---- OAuth: Omron ----
# OMRON_CLIENT_ID=
# OMRON_CLIENT_SECRET=

# Shared OAuth redirect base (update to the production HTTPS URL in prod)
# REDIRECT_URI=https://your-domain.cloudfront.net